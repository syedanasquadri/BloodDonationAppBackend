generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Donor {
    id Int @id @default(autoincrement())
    name String
    bloodGroup String
    phone String
    address String?
    city String?
    state String?
    latitude Float?
    longitude Float?
    isAvailable Boolean @default(true)
}